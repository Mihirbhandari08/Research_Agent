# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=research-agent
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
CORS_ORIGINS=*

# ── LLM — Gemini (Primary) ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini/gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini/gemini-2.0-flash

# ── LLM — OpenAI (Optional Fallback) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# ── LLM — Anthropic (Optional Fallback) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_VERBOSE=false
LITELLM_CACHE=false

# ── Search Tools ──────────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_MAX_RESULTS=5

SERPER_API_KEY=
SERPER_MAX_RESULTS=5

# ── Database — PostgreSQL + pgvector ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=1536

# ── Execution Budgets ─────────────────────────────────────────────────────────
DEFAULT_MAX_DURATION_SECONDS=300.0
DEFAULT_MAX_ITERATIONS=3
DEFAULT_MAX_LLM_CALLS=30
DEFAULT_MAX_TOOL_CALLS=50
DEFAULT_MAX_INPUT_TOKENS=100000
DEFAULT_MAX_OUTPUT_TOKENS=30000
DEFAULT_MAX_COST_USD=1.00

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
TIMEOUT_NODE_SECONDS=30.0
TIMEOUT_LLM_SECONDS=20.0
TIMEOUT_TOOL_SECONDS=10.0

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_JITTER=true

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_TRACING_ENABLED=false

OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=research-agent

# ── Checkpointing ─────────────────────────────────────────────────────────────
# "memory" for dev, "postgres" for production
CHECKPOINT_BACKEND=memory
